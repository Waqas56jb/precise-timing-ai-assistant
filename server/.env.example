PORT=3001

# QuickBooks / Intuit (sandbox first)
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=http://localhost:3001/api/quickbooks/callback
QB_ENVIRONMENT=sandbox
QB_SCOPES=com.intuit.quickbooks.accounting

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DATABASE_POOLER_URL=

# OpenAI (server only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Lead notification emails (Gmail SMTP — use an App Password, not the account password)
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Where new-lead notifications are delivered (defaults to EMAIL_USER)
EMAIL_NOTIFY_TO=

# Admin dashboard password / API bearer token
ADMIN_SECRET=

# Gmail IMAP — same App Password as EMAIL_* (parses Yelp + Thumbtack lead emails)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_UNSEEN_ONLY=true
IMAP_MARK_SEEN=true
IMAP_BATCH_LIMIT=30

# Auto-start IMAP polling with the API server (always-on host / local only — not Vercel)
EMAIL_WORKER_ENABLED=false
EMAIL_WORKER_INTERVAL_MS=60000

# Shared secret for inbound lead webhooks
LEAD_INGEST_SECRET=
THUMBTACK_WEBHOOK_SECRET=
YELP_WEBHOOK_SECRET=
YELP_API_KEY=

# --- Yelp lead capture (confirmed Aug 24) ---
# Inbox: precisetimingtransports@gmail.com (Leon D.)
# Filter: sender *@yelp.com → parse → leads.source=yelp
# Gmail: 2FA ON → App Password (not normal password)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=precisetimingtransports@gmail.com
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_FROM_FILTER=yelp.com
IMAP_UNSEEN_ONLY=true
IMAP_MARK_SEEN=true
IMAP_BATCH_LIMIT=30

# Auto-start with API server (always-on VPS only)
EMAIL_WORKER_ENABLED=false
EMAIL_WORKER_INTERVAL_MS=60000
