PORT=3001

# QuickBooks / Intuit (sandbox first)
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=http://localhost:3001/api/quickbooks/callback
QB_ENVIRONMENT=sandbox
QB_SCOPES=com.intuit.quickbooks.accounting

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DATABASE_POOLER_URL=

# OpenAI (server only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Shared secret for inbound lead webhooks (Zapier / email relay)
# Header: X-Webhook-Secret: <value>
LEAD_INGEST_SECRET=

# Thumbtack (webhook / email parse — Partner API is invite-only)
THUMBTACK_WEBHOOK_SECRET=

# Yelp
# Leads: webhook / RAQ email parse (official Leads API is partner-only)
YELP_WEBHOOK_SECRET=
# Optional: Yelp Fusion API key for business search (not leads)
YELP_API_KEY=
